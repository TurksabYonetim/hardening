---
import Base from "../../layouts/Base.astro";
import { PhaseIndex } from "../../components/PhaseIndex.tsx";
import phases from "../../data/phases.json";
import docs from "../../data/doctype-summary.json";
const satirlar = phases.phases.map(({ id, label, slug, title, summary, tasks }) => ({
	id,
	label,
	slug,
	title,
	summary,
	gorev: tasks.length,
	epic: docs.filter((d) => (d.epic?.phase || "Faz 4") === label).length,
}));
---
<Base title="Fazlar">
	<PhaseIndex client:only="react" phases={satirlar} />
</Base>
