---
import Base from "../layouts/Base.astro";
import HomePage from "../components/HomePage.tsx";
import phases from "../data/phases.json";
import tasks from "../data/tasks.json";
import docs from "../data/doctype-summary.json";
import contexts from "../data/contexts.json";
const counts = { doctypes: docs.length, contexts: contexts.length, tasks: tasks.length, epics: docs.filter((d) => d.epic).length };
---
<Base title="Genel bakış">
	<HomePage client:only="react" phases={phases.phases.map(({ id, label, slug, title, summary, tasks }) => ({ id, label, slug, title, summary, count: tasks.length }))} overviewHtml={phases.overviewHtml} counts={counts} />
</Base>
